{
    "layer": "top",
    "position": "bottom",
    "mode": "hide",
    "exclusive": false,
    "start_hidden": true,
    "modules-center": [
        "hyprland/workspaces",
        "clock",
        "pulseaudio",
        "backlight",
        "custom/battery",
        "tray"
    ],
    "height": 30,
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "show-special": true,
        "special-visible-only": true,
        "on-click": "activate",
        "tooltip": true,
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "icon-size": 20,
            "format": "{icon}"
        }
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 8,
        "show-passive-items": true
    },
    "custom/battery": {
        "exec": "~/.config/waybar/waybar-battery.sh",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },
    "backlight": {
        "format": "◐ {percent}%",
        "tooltip-format": "{percent}%",
        "on-scroll-up": "brightnessctl -e3 -n2 set 1%+",
        "on-scroll-down": "brightnessctl -e3 -n2 set 1%-"
    },
    "pulseaudio": {
        "format": "♪ {volume}%",
        "format-muted": "♪ muted",
        "tooltip-format": "{volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    }
}
