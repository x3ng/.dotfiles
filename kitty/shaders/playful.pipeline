# Kitty 0.49: small effects that run only after the corresponding action.
# To disable one effect, remove its startgroup ... endgroup block.

startgroup
    animation_start tab-change
    animation_stop 100
    animation_curve ease-out
    animation_step 16
    shaders tab-change
endgroup

startgroup
    animation_start pointer-left-button-press
    animation_stop 400
    animation_curve ease-out
    animation_step 16
    var float WAVE_SPEED = 0.16
    var float WAVE_WIDTH = 0.025
    var float AMPLITUDE = 0.0025
    var float NORMAL_SCALE = 4.0
    var float SPECULAR_STRENGTH = 0.10
    var float DIFFUSE_STRENGTH = 0.04
    shaders pond-ripple
endgroup
