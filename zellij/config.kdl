// zellij 配置
//
// locked（默认）: 全部透传给 shell，只响应 Ctrl+\ / Ctrl+Tab 解锁。
// normal: Ctrl+key 进子模式，Alt+key 直接动作。
// 子模式: 裸键全部替换为 Ctrl+组合键，Esc 退出，Ctrl+\ 锁定。
//
// 前提: 不要关 support_kitty_keyboard_protocol，否则 Ctrl+\ 无法识别。

simplified_ui true
default_mode "locked"
default_layout "compact"

theme "iceberg-dark"
theme_dark "iceberg-dark"
theme_light "iceberg-light"

scroll_buffer_size 50000
copy_command "wl-copy"
show_startup_tips false
show_release_notes false

keybinds clear-defaults=true {

    locked {
        bind "Ctrl \\"  { SwitchToMode "normal"; }
        bind "Ctrl Tab" { SwitchToMode "normal"; }
    }

    normal {
        bind "Ctrl \\" { SwitchToMode "locked"; }

        // 进入子模式
        bind "Ctrl p" { SwitchToMode "pane"; }
        bind "Ctrl t" { SwitchToMode "tab"; }
        bind "Ctrl s" { SwitchToMode "scroll"; }
        bind "Ctrl n" { SwitchToMode "resize"; }
        bind "Ctrl h" { SwitchToMode "move"; }

        // 直接动作
        bind "Alt f"  { ToggleFloatingPanes; }
        bind "Alt n"  { NewPane; }
        bind "Alt h"  { MoveFocusOrTab "Left"; }
        bind "Alt l"  { MoveFocusOrTab "Right"; }
        bind "Alt j"  { MoveFocus "Down"; }
        bind "Alt k"  { MoveFocus "Up"; }
        bind "Alt ="  { Resize "Increase"; }
        bind "Alt -"  { Resize "Decrease"; }
        bind "Alt ["  { PreviousSwapLayout; }
        bind "Alt ]"  { NextSwapLayout; }
    }

    pane {
        bind "Ctrl \\"  { SwitchToMode "locked"; }
        bind "Ctrl p"   { SwitchToMode "normal"; }
        bind "Esc"      { SwitchToMode "normal"; }
        bind "Ctrl h"   { MoveFocus "Left"; }
        bind "Ctrl l"   { MoveFocus "Right"; }
        bind "Ctrl j"   { MoveFocus "Down"; }
        bind "Ctrl k"   { MoveFocus "Up"; }
        bind "Ctrl ;"   { FocusLastPane; }
        bind "Ctrl n"   { NewPane; SwitchToMode "normal"; }
        bind "Ctrl d"   { NewPane "Down"; SwitchToMode "normal"; }
        bind "Ctrl r"   { NewPane "Right"; SwitchToMode "normal"; }
        bind "Ctrl s"   { NewPane "stacked"; SwitchToMode "normal"; }
        bind "Ctrl x"   { CloseFocus; SwitchToMode "normal"; }
        bind "Ctrl f"   { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "Ctrl z"   { TogglePaneFrames; SwitchToMode "normal"; }
        bind "Ctrl w"   { ToggleFloatingPanes; SwitchToMode "normal"; }
        bind "Ctrl e"   { TogglePaneEmbedOrFloating; SwitchToMode "normal"; }
        bind "Ctrl i"   { TogglePanePinned; SwitchToMode "normal"; }
    }

    tab {
        bind "Ctrl \\"  { SwitchToMode "locked"; }
        bind "Esc"      { SwitchToMode "normal"; }
        bind "Ctrl t"   { SwitchToMode "normal"; }
        bind "Ctrl r"   { SwitchToMode "renametab"; TabNameInput 0; }
        bind "Ctrl h"   { GoToPreviousTab; }
        bind "Ctrl j"   { GoToNextTab; }
        bind "Ctrl l"   { GoToNextTab; }
        bind "Ctrl k"   { GoToPreviousTab; }
        bind "Ctrl n"   { NewTab; SwitchToMode "normal"; }
        bind "Ctrl x"   { CloseTab; SwitchToMode "normal"; }
        bind "Ctrl s"   { ToggleActiveSyncTab; SwitchToMode "normal"; }
        bind "Ctrl b"   { BreakPane; SwitchToMode "normal"; }
        bind "Ctrl ]"   { BreakPaneRight; SwitchToMode "normal"; }
        bind "Ctrl ["   { BreakPaneLeft; SwitchToMode "normal"; }
        bind "Ctrl 1"   { GoToTab 1; SwitchToMode "normal"; }
        bind "Ctrl 2"   { GoToTab 2; SwitchToMode "normal"; }
        bind "Ctrl 3"   { GoToTab 3; SwitchToMode "normal"; }
        bind "Ctrl 4"   { GoToTab 4; SwitchToMode "normal"; }
        bind "Ctrl 5"   { GoToTab 5; SwitchToMode "normal"; }
        bind "Ctrl 6"   { GoToTab 6; SwitchToMode "normal"; }
        bind "Ctrl 7"   { GoToTab 7; SwitchToMode "normal"; }
        bind "Ctrl 8"   { GoToTab 8; SwitchToMode "normal"; }
        bind "Ctrl 9"   { GoToTab 9; SwitchToMode "normal"; }
    }

    resize {
        bind "Ctrl \\"  { SwitchToMode "locked"; }
        bind "Esc"      { SwitchToMode "normal"; }
        bind "Ctrl n"   { SwitchToMode "normal"; }
        bind "Ctrl h"   { Resize "Increase Left"; }
        bind "Ctrl j"   { Resize "Increase Down"; }
        bind "Ctrl k"   { Resize "Increase Up"; }
        bind "Ctrl l"   { Resize "Increase Right"; }
        bind "Ctrl u"   { Resize "Decrease Left"; }
        bind "Ctrl d"   { Resize "Decrease Down"; }
        bind "Ctrl i"   { Resize "Decrease Up"; }
        bind "Ctrl o"   { Resize "Decrease Right"; }
        bind "Ctrl ="   { Resize "Increase"; }
        bind "Ctrl -"   { Resize "Decrease"; }
    }

    scroll {
        bind "Ctrl \\"  { SwitchToMode "locked"; }
        bind "Esc"      { SwitchToMode "normal"; }
        bind "Ctrl s"   { SwitchToMode "normal"; }
        bind "Ctrl e"   { EditScrollback; SwitchToMode "normal"; }
        bind "Ctrl d"   { HalfPageScrollDown; }
        bind "Ctrl u"   { HalfPageScrollUp; }
        bind "Ctrl j"   { ScrollDown; }
        bind "Ctrl k"   { ScrollUp; }
        bind "Ctrl l"   { PageScrollDown; }
        bind "Ctrl h"   { PageScrollUp; }
        bind "Ctrl ["   { ScrollToPreviousPrompt; }
        bind "Ctrl ]"   { ScrollToNextPrompt; }
        bind "Ctrl m"   { SelectCommandAtScrollPosition; }
        bind "Ctrl x"   { CopyLastCommandOutput; SwitchToMode "normal"; }
        bind "Ctrl c"   { ScrollToBottom; SwitchToMode "normal"; }
    }

    move {
        bind "Ctrl \\"  { SwitchToMode "locked"; }
        bind "Esc"      { SwitchToMode "normal"; }
        bind "Ctrl n"   { MovePane; }
        bind "Ctrl p"   { MovePaneBackwards; }
        bind "Ctrl j"   { MovePane "Down"; }
        bind "Ctrl k"   { MovePane "Up"; }
        bind "Ctrl h"   { MovePane "Left"; }
        bind "Ctrl l"   { MovePane "Right"; }
    }

    entersearch {
        bind "Enter"    { SwitchToMode "search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "scroll"; }
    }

    search {
        bind "Esc" "Ctrl g" "Enter" { SwitchToMode "normal"; }
        bind "Ctrl n"   { Search "down"; }
        bind "Ctrl p"   { Search "up"; }
        bind "Ctrl u"   { HalfPageScrollUp; }
        bind "Ctrl d"   { HalfPageScrollDown; }
        bind "Ctrl l"   { PageScrollDown; }
        bind "Ctrl h"   { PageScrollUp; }
        bind "Ctrl ["   { ScrollToPreviousPrompt; }
        bind "Ctrl ]"   { ScrollToNextPrompt; }
        bind "Ctrl m"   { SelectCommandAtScrollPosition; }
    }

    renamepane {
        bind "Enter"    { SwitchToMode "normal"; }
        bind "Esc"      { UndoRenamePane; SwitchToMode "pane"; }
    }

    renametab {
        bind "Enter"    { SwitchToMode "normal"; }
        bind "Esc"      { UndoRenameTab; SwitchToMode "tab"; }
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar" {
        tooltip "F1"
    }
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    zellij:link
}
