[Unit]
Description=Quickshell Polkit authentication agent
PartOf=graphical-session.target
Conflicts=hyprpolkitagent.service
After=graphical-session.target hyprpolkitagent.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Environment="PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin"
ExecSearchPath=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=quickshell --no-duplicate --path %h/.config/quickshell/polkit
Restart=on-failure
RestartSec=2
