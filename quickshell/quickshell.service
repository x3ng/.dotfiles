[Unit]
Description=Quickshell desktop shell
PartOf=graphical-session.target
Wants=darkman.service quickshell-lock.service quickshell-polkit.service
After=graphical-session.target darkman.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
Environment="PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin"
ExecSearchPath=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=quickshell --no-duplicate --path %h/.config/quickshell
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
