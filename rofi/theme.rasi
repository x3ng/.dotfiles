* {
  background: #171a22;
  background-raised: #232936;
  background-selected: #303847;
  foreground: #f3f5fa;
  foreground-muted: #949db0;
  accent: #72b7e8;
  outline: #ffffff20;

  background-color: transparent;
  text-color: @foreground;
  font: "IosevkaTerm Nerd Font Mono 13";
}

window {
  location: center;
  anchor: center;
  width: 42%;
  padding: 0;
  border: 1px;
  border-color: @outline;
  border-radius: 12px;
  background-color: @background;
}

mainbox {
  padding: 14px;
  spacing: 12px;
  background-color: transparent;
}

inputbar {
  children: [ entry ];
  padding: 10px 12px;
  border-radius: 8px;
  background-color: @background-raised;
}

entry {
  placeholder: "Search applications, commands, and windows";
  placeholder-color: @foreground-muted;
  text-color: @foreground;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  dynamic: true;
  cycle: true;
  scrollbar: false;
  spacing: 4px;
  border: 0;
  background-color: transparent;
}

element {
  padding: 8px 10px;
  spacing: 10px;
  border-radius: 7px;
  background-color: transparent;
  text-color: @foreground;
  cursor: pointer;
}

element selected {
  background-color: @background-selected;
  text-color: @foreground;
}

element-icon {
  size: 28px;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
  background-color: transparent;
  text-color: inherit;
  highlight: bold #72b7e8;
}
