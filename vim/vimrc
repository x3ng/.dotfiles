" === basic ===
set nocompatible
set encoding=utf-8
syntax on
filetype plugin indent on

runtime! macros/matchit.vim

" === interface ===
set number
set relativenumber
set cursorline
set showcmd
set showmode
set scrolloff=5
set sidescrolloff=5
set splitbelow
set splitright
set wildmenu
set wildmode=longest:full,full
set hidden
set backspace=indent,eol,start   " fix backspace in insert mode
set confirm                       " prompt before discarding changes
set history=1000

" === autoread ===
set autoread
autocmd FocusGained,BufEnter * checktime

""" trailing whitespace
highlight ExtraWhitespace ctermbg=red guibg=red
autocmd BufWinEnter * match ExtraWhitespace /\s\+$/
autocmd InsertEnter * match ExtraWhitespace /\s\+\%#\@<!$/
autocmd InsertLeave * match ExtraWhitespace /\s\+$/
autocmd BufWinLeave * call clearmatches()

" === statusline ===
set laststatus=2
set statusline=
set statusline+=%#StatusLine#
set statusline+=\ %f            " filename
set statusline+=\ %m            " modified flag
set statusline+=\ %r            " readonly flag
set statusline+=%=              " right align
set statusline+=\ %y            " filetype
set statusline+=\ %l:%c         " line:col
set statusline+=\ %p%%          " percentage

" === indent ===
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set autoindent

" === search ===
set hlsearch
set incsearch
set ignorecase
set smartcase

" === wildignore ===
set wildignore=*.o,*.obj,*.pyc,*.class,.git,node_modules,__pycache__
set wildignorecase

" === fold ===
set foldmethod=indent
set foldlevel=99

" === line wrap ===
set breakindent
set linebreak

" === undo / swap / backup ===
set undofile
set undodir=~/.vim/undo//
set undolevels=10000
set swapfile
set directory=~/.vim/swap//
set backup
set backupdir=~/.vim/backup//
call mkdir(&undodir, 'p')
call mkdir(&directory, 'p')
call mkdir(&backupdir, 'p')

" === completion ===
set completeopt=menu,menuone,noselect
set omnifunc=syntaxcomplete#Complete
set path+=**                    " recursive :find

" === netrw ===
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_winsize = 25
let g:netrw_altv = 1

" === filetype tweaks ===
autocmd BufNewFile,BufRead *.cc,*.hh set filetype=cpp
""" close netrw if it's the last buffer
autocmd BufEnter * if winnr('$') == 1 && getbufvar(winbufnr(0), '&filetype') ==# 'netrw' | q | endif

" === keymaps ===
""" insert mode — readline keys (bash-compatible)
inoremap <C-a> <ESC>^i
inoremap <C-e> <ESC>$a

""" better defaults
nnoremap Y y$                    " Y yanks to end of line (consistent with D/C)
nnoremap j gj
nnoremap k gk
vnoremap j gj
vnoremap k gk
nnoremap <silent> <leader>h :nohlsearch<CR>

""" indent toggle
nnoremap <silent> <leader>2 :setlocal tabstop=2 softtabstop=2 shiftwidth=2 expandtab<CR>:echo "indent: 2"<CR>
nnoremap <silent> <leader>4 :setlocal tabstop=4 softtabstop=4 shiftwidth=4 expandtab<CR>:echo "indent: 4"<CR>

""" quick save / quit
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

""" buffer / window / file
nnoremap <leader>b <C-o>
nnoremap <leader>e :Lexplore<CR>
nnoremap <leader>E :Explore<CR>
nnoremap <leader>ff :find *
nnoremap <leader>fb :buffer *
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

""" terminal
nnoremap <silent> <leader>tt :terminal<CR>
nnoremap <silent> <leader>tv :vert terminal<CR>
